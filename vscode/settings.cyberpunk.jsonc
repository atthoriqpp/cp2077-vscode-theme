{
    // Cyberpunk 2077 colours, fonts and editor feel. Merge into your VS Code settings.json.
    // Change the two file:/// paths below to your own user folder.
    "workbench.colorTheme": "Dark Modern",
    "editor.fontFamily": "'Share Tech Mono', Consolas, monospace",
    "editor.fontSize": 15,
    "terminal.integrated.fontFamily": "'Cascadia Code', Consolas, monospace",
    "editor.cursorStyle": "block",
    "editor.cursorBlinking": "phase",
    "terminal.integrated.cursorStyle": "block",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "editor.renderLineHighlight": "all",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "workbench.tree.renderIndentGuides": "always",
    "editor.semanticHighlighting.enabled": true,
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "parameter": { "foreground": "#FFB86B", "italic": true },
            "property": "#02D7F2",
            "enumMember": "#FF2BD6",
            "*.readonly": { "foreground": "#FF2BD6" },
            "class": { "foreground": "#FF003C", "bold": true },
            "interface": "#FF6B8A",
            "namespace": "#FCEE0A"
        }
    },
    "vscode_custom_css.imports": ["file:///C:/Users/YOUR_NAME/AppData/Roaming/Code/User/cyberpunk2077.css", "file:///C:/Users/YOUR_NAME/AppData/Roaming/Code/User/cyberpunk-fx.js"],
    "workbench.colorCustomizations": {
        "focusBorder": "#00000000",
        "foreground": "#E6E6EA",
        "selection.background": "#FCEE0A55",
        "widget.border": "#02D7F2",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#FCEE0A",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#7A7A90",
        "titleBar.border": "#FCEE0A",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#FCEE0A",
        "activityBar.inactiveForeground": "#5A5A6E",
        "activityBar.activeBorder": "#FCEE0A",
        "activityBar.border": "#1E1E28",
        "activityBarBadge.background": "#FF003C",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#0A0A0E",
        "sideBar.foreground": "#C8C8D0",
        "sideBar.border": "#1E1E28",
        "sideBarTitle.foreground": "#FCEE0A",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.foreground": "#02D7F2",
        "sideBarSectionHeader.border": "#1E1E28",
        "list.activeSelectionBackground": "#FCEE0A",
        "list.activeSelectionForeground": "#000000",
        "list.inactiveSelectionBackground": "#2A2A10",
        "list.inactiveSelectionForeground": "#FCEE0A",
        "list.hoverBackground": "#16161F",
        "list.focusOutline": "#02D7F2",
        "list.highlightForeground": "#02D7F2",
        "editorGroupHeader.tabsBackground": "#000000",
        "editorGroupHeader.tabsBorder": "#1E1E28",
        "tab.activeBackground": "#0D0D12",
        "tab.activeForeground": "#FCEE0A",
        "tab.activeBorderTop": "#FCEE0A",
        "tab.inactiveBackground": "#000000",
        "tab.inactiveForeground": "#6A6A7E",
        "tab.border": "#1E1E28",
        "tab.hoverBackground": "#14141C",
        "editor.background": "#0D0D12",
        "editor.foreground": "#E6E6EA",
        "editor.lineHighlightBackground": "#16161F",
        "editor.lineHighlightBorder": "#00000000",
        "editor.selectionBackground": "#FCEE0A99",
        "editor.inactiveSelectionBackground": "#FCEE0A38",
        "editor.selectionForeground": "#FFFFFF",
        "editor.selectionHighlightBackground": "#02D7F280",
        "editor.selectionHighlightBorder": "#02D7F2",
        "editor.findMatchBackground": "#FF003C66",
        "editor.findMatchHighlightBackground": "#02D7F240",
        "editorCursor.foreground": "#FCEE0A",
        "editorLineNumber.foreground": "#3C3C4C",
        "editorLineNumber.activeForeground": "#FCEE0A",
        "editorIndentGuide.background1": "#1C1C26",
        "editorIndentGuide.activeBackground1": "#02D7F280",
        "editorBracketMatch.border": "#02D7F2",
        "editorBracketMatch.background": "#02D7F220",
        "editorError.foreground": "#FF003C",
        "editorWarning.foreground": "#FCEE0A",
        "editorInfo.foreground": "#02D7F2",
        "editorGutter.addedBackground": "#00FF9C",
        "editorGutter.modifiedBackground": "#02D7F2",
        "editorGutter.deletedBackground": "#FF003C",
        "editorWidget.background": "#0A0A0E",
        "editorWidget.border": "#02D7F2",
        "editorSuggestWidget.selectedBackground": "#FCEE0A",
        "editorSuggestWidget.selectedForeground": "#000000",
        "editorSuggestWidget.highlightForeground": "#02D7F2",
        "minimap.background": "#0A0A0E",
        "scrollbarSlider.background": "#FCEE0A22",
        "scrollbarSlider.hoverBackground": "#FCEE0A44",
        "scrollbarSlider.activeBackground": "#FCEE0A77",
        "panel.background": "#0A0A0E",
        "panel.border": "#1A1A24",
        "panelTitle.activeForeground": "#FCEE0A",
        "panelTitle.activeBorder": "#FCEE0A",
        "panelTitle.inactiveForeground": "#6A6A7E",
        "statusBar.background": "#050508",
        "statusBar.foreground": "#8FA3B0",
        "statusBar.border": "#FCEE0A",
        "statusBar.noFolderBackground": "#050508",
        "statusBar.debuggingBackground": "#FF003C",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#FCEE0A1F",
        "statusBarItem.hoverForeground": "#FCEE0A",
        "statusBarItem.prominentForeground": "#02D7F2",
        "statusBarItem.errorForeground": "#FF003C",
        "statusBarItem.warningForeground": "#FCEE0A",
        "statusBarItem.remoteBackground": "#FF003C",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "button.background": "#FCEE0A",
        "button.foreground": "#000000",
        "button.hoverBackground": "#FFF75A",
        "badge.background": "#FF003C",
        "badge.foreground": "#FFFFFF",
        "input.background": "#000000",
        "input.border": "#2A2A38",
        "inputOption.activeBorder": "#FCEE0A",
        "progressBar.background": "#02D7F2",
        "quickInput.background": "#0A0A0E",
        "quickInputList.focusBackground": "#FCEE0A",
        "quickInputList.focusForeground": "#000000",
        "editorBracketHighlight.foreground1": "#FCEE0A",
        "editorBracketHighlight.foreground2": "#02D7F2",
        "editorBracketHighlight.foreground3": "#FF2BD6",
        "editorBracketHighlight.foreground4": "#00FF9C",
        "editorBracketHighlight.unexpectedBracket.foreground": "#FF003C",
        "editorBracketPairGuide.activeBackground1": "#FCEE0A80",
        "editorBracketPairGuide.activeBackground2": "#02D7F280",
        "editorBracketPairGuide.activeBackground3": "#FF2BD680",
        "breadcrumb.foreground": "#6A6A7E",
        "breadcrumb.focusForeground": "#FCEE0A",
        "breadcrumb.activeSelectionForeground": "#02D7F2",
        "breadcrumb.background": "#0D0D12",
        "menu.background": "#0A0A0E",
        "menu.foreground": "#E6E6EA",
        "menu.selectionBackground": "#FCEE0A",
        "menu.selectionForeground": "#000000",
        "menu.separatorBackground": "#2A2A38",
        "menu.border": "#02D7F2",
        "menubar.selectionBackground": "#FCEE0A",
        "menubar.selectionForeground": "#000000",
        "commandCenter.background": "#0A0A0E",
        "commandCenter.foreground": "#FCEE0A",
        "commandCenter.border": "#FCEE0A66",
        "commandCenter.activeBorder": "#FCEE0A",
        "commandCenter.activeForeground": "#FCEE0A",
        "commandCenter.activeBackground": "#FCEE0A14",
        "notifications.background": "#0A0A0E",
        "notifications.border": "#02D7F2",
        "notificationCenterHeader.background": "#000000",
        "notificationCenterHeader.foreground": "#FCEE0A",
        "notificationToast.border": "#02D7F2",
        "notificationsErrorIcon.foreground": "#FF003C",
        "notificationsWarningIcon.foreground": "#FCEE0A",
        "notificationsInfoIcon.foreground": "#02D7F2",
        "editorHoverWidget.background": "#0A0A0E",
        "editorHoverWidget.border": "#02D7F2",
        "peekView.border": "#FCEE0A",
        "peekViewTitle.background": "#000000",
        "peekViewTitleLabel.foreground": "#FCEE0A",
        "peekViewEditor.background": "#0A0A0E",
        "peekViewResult.background": "#000000",
        "peekViewResult.selectionBackground": "#FCEE0A33",
        "diffEditor.insertedTextBackground": "#00FF9C22",
        "diffEditor.removedTextBackground": "#FF003C26",
        "diffEditor.insertedLineBackground": "#00FF9C12",
        "diffEditor.removedLineBackground": "#FF003C14",
        "gitDecoration.modifiedResourceForeground": "#02D7F2",
        "gitDecoration.untrackedResourceForeground": "#00FF9C",
        "gitDecoration.addedResourceForeground": "#00FF9C",
        "gitDecoration.deletedResourceForeground": "#FF003C",
        "gitDecoration.conflictingResourceForeground": "#FF2BD6",
        "gitDecoration.ignoredResourceForeground": "#4A4A5C",
        "editorStickyScroll.background": "#0A0A0E",
        "editorStickyScroll.shadow": "#FCEE0A40",
        "editorOverviewRuler.border": "#1E1E28",
        "editorOverviewRuler.errorForeground": "#FF003C",
        "editorOverviewRuler.warningForeground": "#FCEE0A",
        "editorOverviewRuler.modifiedForeground": "#02D7F2",
        "textLink.foreground": "#02D7F2",
        "textLink.activeForeground": "#FCEE0A",
        "textPreformat.foreground": "#FCEE0A",
        "textBlockQuote.border": "#FCEE0A",
        "keybindingLabel.background": "#FCEE0A22",
        "keybindingLabel.foreground": "#FCEE0A",
        "keybindingLabel.border": "#FCEE0A66",
        "checkbox.border": "#FCEE0A",
        "dropdown.background": "#000000",
        "dropdown.border": "#2A2A38",
        "icon.foreground": "#C8C8D0",
        "sash.hoverBorder": "#FCEE0A",
        "terminal.selectionBackground": "#FCEE0A40",
        "terminal.background": "#0A0A0E",
        "terminal.foreground": "#E6E6EA",
        "terminalCursor.foreground": "#FCEE0A",
        "terminal.ansiBlack": "#0D0D12",
        "terminal.ansiRed": "#FF003C",
        "terminal.ansiGreen": "#00FF9C",
        "terminal.ansiYellow": "#FCEE0A",
        "terminal.ansiBlue": "#02D7F2",
        "terminal.ansiMagenta": "#FF2BD6",
        "terminal.ansiCyan": "#02D7F2",
        "terminal.ansiWhite": "#E6E6EA",
        "terminal.ansiBrightBlack": "#5A5A6E",
        "terminal.ansiBrightRed": "#FF4D6D",
        "terminal.ansiBrightGreen": "#5CFFC0",
        "terminal.ansiBrightYellow": "#FFF75A",
        "terminal.ansiBrightBlue": "#5CE6FF",
        "terminal.ansiBrightMagenta": "#FF6BE3",
        "terminal.ansiBrightCyan": "#5CE6FF",
        "terminal.ansiBrightWhite": "#FFFFFF"
    },
    "editor.tokenColorCustomizations": {
        "comments": "#6E6E86",
        "keywords": "#FCEE0A",
        "strings": "#02D7F2",
        "numbers": "#FF2BD6",
        "functions": "#00FF9C",
        "types": "#FF003C",
        "variables": "#E6E6EA",
        "textMateRules": [
            { "scope": ["storage", "storage.type", "keyword.operator.new"], "settings": { "foreground": "#FCEE0A" } },
            { "scope": ["constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#FF2BD6" } },
            { "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#FCEE0A" } },
            { "scope": ["entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#02D7F2" } },
            { "scope": ["punctuation", "keyword.operator"], "settings": { "foreground": "#9A9AB0" } },
            { "scope": ["comment"], "settings": { "fontStyle": "italic" } }
        ]
    }
}
