{
  "name": "world-wire",
  "displayName": "World Wire",
  "description": "Fetches a few public news feeds and crypto and stock quotes and hands them to the cyberpunk news row through a hidden status bar item. No tracking, no keys.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "World Wire",
      "properties": {
        "worldWire.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Fetch real world headlines and prices for the news row."
        },
        "worldWire.refreshMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "Minutes between fetches."
        },
        "worldWire.feeds": {
          "type": "array",
          "description": "RSS feeds to read (https only). Only the item titles and the site's icon are used.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "Optional https URL of a small logo. Default is the site's /favicon.ico."
              }
            },
            "required": [
              "name",
              "url"
            ]
          },
          "default": [
            {
              "name": "BBC",
              "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
              "icon": "https://www.bbc.com/favicon.ico"
            },
            {
              "name": "GUARDIAN",
              "url": "https://www.theguardian.com/world/rss",
              "icon": "https://www.theguardian.com/favicon.ico"
            },
            {
              "name": "NPR",
              "url": "https://feeds.npr.org/1001/rss.xml",
              "icon": "https://www.npr.org/favicon.ico"
            },
            {
              "name": "AL JAZEERA",
              "url": "https://www.aljazeera.com/xml/rss/all.xml",
              "icon": "https://www.aljazeera.com/favicon.ico"
            },
            {
              "name": "ANTARA",
              "url": "https://www.antaranews.com/rss/terkini.xml",
              "icon": "https://www.antaranews.com/favicon.ico"
            },
            {
              "name": "CNN INDONESIA",
              "url": "https://www.cnnindonesia.com/nasional/rss",
              "icon": "https://www.cnnindonesia.com/favicon.ico"
            },
            {
              "name": "TEMPO",
              "url": "https://rss.tempo.co/nasional",
              "icon": "https://www.tempo.co/favicon.ico"
            },
            {
              "name": "CNBC INDONESIA",
              "url": "https://www.cnbcindonesia.com/news/rss",
              "icon": "https://cdn.cnbcindonesia.com/cnbc/images/logo/2026/favicon.png?v=7.1.1"
            }
          ]
        },
        "worldWire.crypto": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "bitcoin",
            "ethereum",
            "solana"
          ],
          "description": "CoinGecko coin ids for the price segment."
        },
        "worldWire.stocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^GSPC",
            "^IXIC",
            "^DJI",
            "AAPL",
            "NVDA",
            "TSLA",
            "MSFT"
          ],
          "description": "Yahoo Finance symbols for the price segment (indices start with ^)."
        },
        "worldWire.location": {
          "type": "string",
          "default": "",
          "description": "Weather location. Set it with the command \"World Wire: Set Location\" (or click the weather chip in the news row), which searches real places; or type a city name or \"lat,lon\". Empty turns weather off. Only this text is sent to Open-Meteo."
        }
      }
    },
    "commands": [
      {
        "command": "worldWire.setLocation",
        "title": "World Wire: Set Location"
      }
    ]
  }
}
